    "name": "ngrok AI Gateway API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The ngrok AI Gateway exposes drop-in compatible REST endpoints\nfor OpenAI's Chat Completions API and Anthropic's Messages API.\nRequests are authenticated with an AI Gateway API key issued by\nngrok, and the gateway forwards calls to managed upstream\nproviders using ngrok's own provider credentials.\n",
      "type": "text/plain"
